# --- data layer (treg.to) -----------------------------------------------------
# One token, 111 providers, pay-per-answer.  https://treg.to/llms.txt
# curl -fsSL https://treg.to/install.sh | sh     then    treg login
TREG_TOKEN=

# --- CRM: pick one (rules.writeback.crm) --------------------------------------
# Attio — workspace API key. Scopes: record_permission:read-write,
# object_configuration:read, list_configuration:read-write, list_entry:read-write
ATTIO_TOKEN=

# HubSpot — private app access token. Scopes: crm.objects.companies.write,
# crm.objects.contacts.write, crm.objects.contacts.read
HUBSPOT_TOKEN=

# Salesforce — OAuth access token + the instance URL it was issued for.
# Scopes: api, refresh_token, offline_access
SALESFORCE_TOKEN=
SALESFORCE_INSTANCE_URL=https://your-org.my.salesforce.com
# Upsert key for Account/Contact. Must be a field marked External ID + Unique.
SALESFORCE_EXTERNAL_ID_FIELD=External_Id__c

# --- safety -------------------------------------------------------------------
# Global kill switch. Anything other than "on" makes the pipeline propose-only.
ORIGINATION_KILL_SWITCH=off
# Daily spend rail; overrides rules.spend.cap_per_day_usd.
ORIGINATION_CAP_PER_DAY_USD=
